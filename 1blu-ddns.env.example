USERNAME=1234567
PASSWORD=change-me
CONTRACT=123123
DOMAIN_NUMBER=123456
DOMAIN=example.de

# Optional: 2FA setup secret, not a currently displayed one-time code.
OTP_KEY=

# Optional: comma-separated hostnames. Use @ for the base domain.
# Examples:
# SUBDOMAIN=@
# SUBDOMAIN=cloud,home{AAAA},@{A}
SUBDOMAIN=@

# A for IPv4, AAAA for IPv6.
RRTYPE=A

# Used only when running without --once. Cron uses --once every minute.
INTERVAL=180

LOGGING_LEVEL=INFO
